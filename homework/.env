# Homework 微服务环境变量配置示例
# 复制此文件为 .env 并根据实际环境修改配置

# Nacos 服务器地址
# 格式: IP:端口
NACOS_SERVER_ADDR=192.168.1.38:8848

# 服务端口
# 开发环境建议使用 18080，生产环境建议使用 8080
SERVER_PORT=18080

# ===================================================================
# 数据库配置 - MySQL + Spring Data JPA
# ===================================================================

# 数据库连接配置
DATABASE_URL=jdbc:mysql://localhost:3306/homework_db?useUnicode=true&characterEncoding=utf8&zeroDateTimeBehavior=convertToNull&useSSL=false&serverTimezone=Asia/Shanghai&allowPublicKeyRetrieval=true
DATABASE_USERNAME=root
DATABASE_PASSWORD=root123

# 开发环境数据库配置
DEV_DATABASE_URL=jdbc:mysql://192.168.1.251:3306/jlm-homework-design?useUnicode=true&characterEncoding=utf8&zeroDateTimeBehavior=convertToNull&useSSL=false&serverTimezone=Asia/Shanghai&allowPublicKeyRetrieval=true
DEV_DATABASE_USERNAME=root
DEV_DATABASE_PASSWORD=jlm@1234

# 生产环境数据库配置
PROD_DATABASE_URL=jdbc:mysql://prod-mysql-server:3306/homework_prod?useUnicode=true&characterEncoding=utf8&zeroDateTimeBehavior=convertToNull&useSSL=true&serverTimezone=Asia/Shanghai
PROD_DATABASE_USERNAME=homework_user
PROD_DATABASE_PASSWORD=your_prod_password_here

# JPA 配置
JPA_SHOW_SQL=true
JPA_DDL_AUTO=update
HIBERNATE_SQL_LOG_LEVEL=DEBUG
HIBERNATE_PARAM_LOG_LEVEL=TRACE

# 连接池配置 (HikariCP)
HIKARI_MAXIMUM_POOL_SIZE=20
HIKARI_MINIMUM_IDLE=5
HIKARI_CONNECTION_TIMEOUT=30000
HIKARI_IDLE_TIMEOUT=600000
HIKARI_MAX_LIFETIME=1800000

# 日志级别配置
LOG_LEVEL_ROOT=INFO
LOG_LEVEL_HOMEWORK=DEBUG
LOG_LEVEL_HIBERNATE_SQL=DEBUG
LOG_LEVEL_HIBERNATE_PARAM=TRACE
LOG_LEVEL_SPRING_DATA_JPA=DEBUG

# 使用示例:
# 1. 复制文件: cp .env.example .env
# 2. 修改配置: 编辑 .env 文件中的值
# 3. 加载环境变量: source .env
# 4. 启动服务: ./start.sh dev
